<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../partials/head') %></head>
<body class="bg-slate-50 text-slate-800" style="min-height:100svh">

<%- include('../partials/student-nav', { student, activePage: 'Homework' }) %>

<main class="max-w-3xl mx-auto px-4 sm:px-6 py-6 space-y-5 pb-safe lg:pb-8">

  <!-- Flash -->
  <% if (success) { %>
    <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm flex items-center gap-2">
      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span><%= success %></span>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-sm"><%= error %></div>
  <% } %>

  <!-- Back -->
  <a href="/homework" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-brand-navy transition font-medium">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
    Back to Homework
  </a>

  <!-- Homework Info -->
  <div class="bg-brand-navy rounded-2xl p-6">
    <p class="text-indigo-300 text-xs font-semibold uppercase tracking-wider mb-1">
      <%= hw.lesson?.title || 'Lesson' %>
    </p>
    <h1 class="text-2xl font-extrabold text-white"><%= hw.title %></h1>
    <% if (hw.description) { %><p class="text-indigo-200 text-sm mt-2"><%= hw.description %></p><% } %>
    <div class="flex flex-wrap gap-4 mt-3 text-sm">
      <% if (hw.dueDate) { %>
        <span class="text-indigo-300">
          Due: <span class="text-white font-semibold"><%= new Date(hw.dueDate).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></span>
        </span>
      <% } %>
      <% if (hw.course) { %>
        <span class="text-indigo-300">Course: <span class="text-white font-semibold"><%= hw.course.title %></span></span>
      <% } %>
    </div>

    <!-- Attachments -->
    <% if (hw.attachments && hw.attachments.length > 0) { %>
      <div class="mt-4 flex flex-wrap gap-2">
        <% hw.attachments.forEach(att => { %>
          <a href="<%= att.url %>" target="_blank"
             class="inline-flex items-center gap-1 px-3 py-1.5 bg-white/10 hover:bg-white/20 rounded-lg text-xs text-white transition">
            📎 <%= att.name %>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Existing Submission Status -->
  <% if (existingSubmission) { %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-bold text-slate-900">Your Current Submission</h2>
        <%
          const statusColors = {
            pending: 'bg-amber-100 text-amber-700',
            review: 'bg-blue-100 text-blue-700',
            approved: 'bg-emerald-100 text-emerald-700',
            rejected: 'bg-red-100 text-red-600',
          };
          const rawSubStatus = existingSubmission?.status || 'pending';
          const safeSubStatus = (typeof rawSubStatus === 'string' && rawSubStatus.length > 0)
            ? (rawSubStatus.charAt(0).toUpperCase() + rawSubStatus.slice(1).toLowerCase())
            : 'Pending';
        %>
        <span class="px-3 py-1 rounded-full text-xs font-bold <%= statusColors[rawSubStatus] || statusColors.pending %>">
          <%= safeSubStatus %>
        </span>
      </div>
      <div class="space-y-2">
        <% (existingSubmission.submissionLinks || []).forEach((link, i) => { %>
          <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200">
            <span class="w-6 h-6 rounded-full bg-brand-navy text-white text-xs font-bold flex items-center justify-center shrink-0"><%= i + 1 %></span>
            <div class="flex-1 min-w-0">
              <% if (link.label) { %><div class="text-xs font-semibold text-slate-500"><%= link.label %></div><% } %>
              <a href="<%= link.url %>" target="_blank" class="text-sm text-brand-navy hover:underline truncate block"><%= link.url %></a>
            </div>
          </div>
        <% }) %>
      </div>
      <% if (existingSubmission.feedback) { %>
        <div class="mt-4 p-4 bg-emerald-50 border border-emerald-200 rounded-xl">
          <div class="text-xs font-bold text-emerald-800 mb-1">Admin Feedback</div>
          <% if (existingSubmission.marks) { %><div class="text-sm font-semibold text-emerald-800">📊 Marks: <%= existingSubmission.marks %></div><% } %>
          <% if (existingSubmission.rating) { %><div class="text-sm text-emerald-700">⭐ Rating: <%= existingSubmission.rating %>/5</div><% } %>
          <div class="text-sm text-emerald-700 mt-1"><%= existingSubmission.feedback %></div>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- Submission Form -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
    <h2 class="text-lg font-bold text-slate-900 mb-2">
      <%= existingSubmission ? 'Update Your Submission' : 'Submit Your Work' %>
    </h2>
    <p class="text-sm text-slate-500 mb-5">Add links to your work — Instagram reels, YouTube videos, Google Drive files, Behance, portfolio, etc.</p>

    <form method="POST" action="/homework/<%= hw._id %>/submit" id="submissionForm" class="space-y-4">

      <div id="linksContainer" class="space-y-3">
        <!-- Pre-populate with existing links or one blank -->
        <% const existingLinks = existingSubmission?.submissionLinks || [{ label: '', url: '' }]; %>
        <% existingLinks.forEach((link, i) => { %>
          <div class="link-item flex items-start gap-3">
            <div class="flex-1 grid grid-cols-1 sm:grid-cols-3 gap-2">
              <input type="text" name="links[<%= i %>][label]" value="<%= link.label %>"
                     placeholder="Label (e.g., Instagram Reel)"
                     class="px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
              <input type="url" name="links[<%= i %>][url]" value="<%= link.url %>" required
                     placeholder="Paste link here..."
                     class="sm:col-span-2 px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
            </div>
            <% if (i > 0) { %>
              <button type="button" onclick="removeLinkRow(this)" class="mt-3 text-red-400 hover:text-red-600 transition">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </button>
            <% } else { %>
              <div class="w-5"></div>
            <% } %>
          </div>
        <% }) %>
      </div>

      <!-- Add Another Link -->
      <button type="button" onclick="addLinkRow()"
              class="flex items-center gap-2 text-brand-navy text-sm font-semibold hover:underline transition">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
        + Add Another Link
      </button>

      <div class="pt-2">
        <button type="submit" class="w-full py-3.5 bg-brand-navy hover:bg-brand-navyDark text-white font-bold text-sm rounded-xl transition shadow-sm">
          <%= existingSubmission ? 'Update Submission' : '📤 Submit Homework' %>
        </button>
      </div>
    </form>
  </div>

</main>

<footer class="max-w-3xl mx-auto px-4 sm:px-6 py-6 text-center text-xs text-slate-400 border-t border-slate-200 mt-4">
  Maths Manthra Student Portal &copy; <%= new Date().getFullYear() %>
</footer>

<script>
let linkCount = <%= (existingSubmission?.submissionLinks?.length || 1) %>;

function addLinkRow() {
  const container = document.getElementById('linksContainer');
  const div = document.createElement('div');
  div.className = 'link-item flex items-start gap-3';
  div.innerHTML = `
    <div class="flex-1 grid grid-cols-1 sm:grid-cols-3 gap-2">
      <input type="text" name="links[${linkCount}][label]" placeholder="Label (e.g., YouTube Video)"
             class="px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
      <input type="url" name="links[${linkCount}][url]" required placeholder="Paste link here..."
             class="sm:col-span-2 px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
    </div>
    <button type="button" onclick="removeLinkRow(this)" class="mt-3 text-red-400 hover:text-red-600 transition">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  `;
  container.appendChild(div);
  linkCount++;
}

function removeLinkRow(btn) {
  btn.closest('.link-item').remove();
}
</script>
</body>
</html>
