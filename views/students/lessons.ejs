<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../partials/head') %></head>
<body class="bg-slate-50 text-slate-800" style="min-height:100svh">

<%- include('../partials/student-nav', { student, activePage: 'Lessons' }) %>

<main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 space-y-5 pb-safe lg:pb-8">

  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900">My Lessons</h1>
      <p class="text-sm text-slate-500 mt-0.5"><%= course ? course.title : 'No course assigned' %></p>
    </div>
    <% if (lessons && lessons.length > 0) { %>
      <div class="text-sm font-semibold text-slate-500 bg-white border border-slate-200 px-4 py-2 rounded-xl">
        <%= lessons.length %> lesson<%= lessons.length === 1 ? '' : 's' %>
      </div>
    <% } %>
  </div>

  <% if (lessons && lessons.length > 0) { %>
    <div class="space-y-4">
      <% lessons.forEach((lesson, i) => {
        const isUpcoming = lesson.status === 'upcoming';
        const isLive = lesson.status === 'live';
        const isCompleted = lesson.status === 'completed';
      %>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">

          <!-- Status Bar -->
          <div class="h-1 <%= isLive ? 'bg-red-500' : isCompleted ? 'bg-emerald-500' : 'bg-slate-200' %>"></div>

          <div class="p-6">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
              <div class="flex items-start gap-4">
                <!-- Lesson Number -->
                <div class="w-10 h-10 rounded-xl flex items-center justify-center font-bold text-sm shrink-0
                  <%= isLive ? 'bg-red-100 text-red-600' : isCompleted ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-500' %>">
                  <%= i + 1 %>
                </div>

                <div>
                  <div class="flex items-center gap-2 flex-wrap">
                    <h2 class="font-bold text-slate-900 text-lg"><%= lesson.title %></h2>
                    <!-- Status Badge -->
                    <% if (isLive) { %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-600">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
                        LIVE
                      </span>
                    <% } else if (isCompleted) { %>
                      <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700">✓ Completed</span>
                    <% } else { %>
                      <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-500">Upcoming</span>
                    <% } %>
                  </div>

                  <!-- Date & Time -->
                  <% if (lesson.lessonDate || lesson.lessonTime) { %>
                    <div class="flex items-center gap-3 mt-1 text-sm text-slate-500 flex-wrap">
                      <% if (lesson.lessonDate) { %>
                        <span class="flex items-center gap-1">
                          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                          <%= new Date(lesson.lessonDate).toLocaleDateString('en-IN', {weekday:'short', day:'numeric', month:'short', year:'numeric'}) %>
                        </span>
                      <% } %>
                      <% if (lesson.lessonTime) { %>
                        <span class="flex items-center gap-1">
                          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
                          <%= lesson.lessonTime %>
                        </span>
                      <% } %>
                    </div>
                  <% } %>

                  <% if (lesson.description) { %>
                    <p class="text-sm text-slate-600 mt-2 leading-relaxed"><%= lesson.description %></p>
                  <% } %>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-col gap-2 sm:items-end shrink-0">
                <!-- Join Live Class button — show only if NOT completed -->
                <% if (!isCompleted && lesson.meetLink) { %>
                  <a href="<%= lesson.meetLink %>" target="_blank" rel="noopener noreferrer"
                     class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm transition shadow-sm
                       <%= isLive ? 'bg-red-500 hover:bg-red-600 text-white animate-pulse-slow' : 'bg-brand-navy hover:bg-brand-navyDark text-white' %>">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 10l5-3v10l-5-3V10z"/><rect x="2" y="8" width="13" height="9" rx="1.5"/></svg>
                    <%= isLive ? '🔴 Join Now' : 'Join Class' %>
                  </a>
                <% } %>
              </div>
            </div>

            <!-- PDF Materials -->
            <% if (lesson.pdfMaterials && lesson.pdfMaterials.length > 0) { %>
              <div class="mt-4 pt-4 border-t border-slate-100">
                <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">📄 Study Materials</h3>
                <div class="flex flex-wrap gap-2">
                  <% lesson.pdfMaterials.forEach(pdf => { %>
                    <a href="<%= pdf.url %>" target="_blank"
                       class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg text-xs text-slate-700 font-medium transition">
                      <svg class="w-3.5 h-3.5 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
                      <%= pdf.name %>
                    </a>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <!-- Homework Section — show only when completed -->
            <% if (isCompleted && lesson.homeworkDescription) { %>
              <div class="mt-4 pt-4 border-t border-slate-100">
                <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
                  <h3 class="text-sm font-bold text-amber-800 flex items-center gap-2 mb-1">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
                    Homework
                  </h3>
                  <p class="text-sm text-amber-700"><%= lesson.homeworkDescription %></p>
                  <a href="/homework" class="mt-2 inline-block text-brand-navy font-semibold text-xs hover:underline">
                    Submit via Homework page →
                  </a>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm py-20 text-center">
      <svg class="w-12 h-12 mx-auto text-slate-300 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19.5A2.5 2.5 0 016.5 17H20M4 5.5A2.5 2.5 0 016.5 3H20v15H6.5A2.5 2.5 0 004 20.5v-15z"/></svg>
      <p class="text-slate-500 font-medium">No lessons available yet.</p>
      <p class="text-slate-400 text-sm mt-1">Your lessons will appear here once your admin adds them.</p>
    </div>
  <% } %>

</main>

</body>
</html>
