<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../partials/head') %></head>
<body class="bg-slate-50 text-slate-800" style="min-height:100svh">

<%- include('../partials/student-nav', { student, activePage: 'Dashboard' }) %>

<main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 space-y-5 pb-safe lg:pb-8">

  <!-- Flash Messages -->
  <% if (success) { %>
    <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm flex items-center gap-2">
      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <!-- Welcome Banner -->
  <div class="bg-brand-navy rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <p class="text-indigo-300 text-sm font-medium mb-1">Welcome back 👋</p>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight"><%= student.name %></h1>
      <p class="text-indigo-300 text-sm mt-1"><%= student.email || student.phone %></p>
    </div>
    <div class="flex items-center gap-3">
      <%
        const feeColorMap = { paid: 'bg-emerald-400/20 text-emerald-200 border-emerald-400/40', pending: 'bg-amber-400/20 text-amber-200 border-amber-400/40', overdue: 'bg-red-400/20 text-red-200 border-red-400/40' };
        const rawFeeStatus = student?.feeStatus || 'pending';
        const safeFeeStatus = (typeof rawFeeStatus === 'string' && rawFeeStatus.length > 0)
          ? (rawFeeStatus.charAt(0).toUpperCase() + rawFeeStatus.slice(1).toLowerCase())
          : 'Pending';

        const statusColorMap = { active: 'bg-emerald-400/20 text-emerald-200 border-emerald-400/40', inactive: 'bg-slate-400/20 text-slate-300 border-slate-400/40', graduated: 'bg-blue-400/20 text-blue-200 border-blue-400/40' };
        const rawStudentStatus = student?.status || 'active';
        const safeStudentStatus = (typeof rawStudentStatus === 'string' && rawStudentStatus.length > 0)
          ? (rawStudentStatus.charAt(0).toUpperCase() + rawStudentStatus.slice(1).toLowerCase())
          : 'Active';
      %>
      <span class="px-4 py-1.5 rounded-full text-xs font-bold border <%= feeColorMap[rawFeeStatus] || feeColorMap.pending %>">
        Fee: <%= safeFeeStatus %>
      </span>
      <span class="px-4 py-1.5 rounded-full text-xs font-bold border <%= statusColorMap[rawStudentStatus] || statusColorMap.active %>">
        <%= safeStudentStatus %>
      </span>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

    <!-- Course -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">
        <svg class="w-4 h-4 text-brand-navy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5v-15Z"/></svg>
        Course
      </div>
      <% if (student.course) { %>
        <div class="text-base font-bold text-slate-900 leading-snug"><%= student.course.title %></div>
        <% if (student.course.duration) { %>
          <div class="text-xs text-slate-400 mt-1"><%= student.course.duration %></div>
        <% } %>
      <% } else { %>
        <div class="text-sm text-slate-400 italic">Not enrolled</div>
      <% } %>
    </div>

    <!-- Batch -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">
        <svg class="w-4 h-4 text-brand-navy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/></svg>
        Batch
      </div>
      <% if (student.batch) { %>
        <div class="text-base font-bold text-slate-900"><%= student.batch.batchName %></div>
        <% if (student.batch.mentor) { %>
          <div class="text-xs text-slate-400 mt-1">Mentor: <%= student.batch.mentor %></div>
        <% } %>
        <% const batchStatusMap = { active: 'text-emerald-600', upcoming: 'text-amber-600', completed: 'text-slate-400' }; %>
        <div class="text-xs font-semibold mt-1 <%= batchStatusMap[student.batch.status] || '' %>">
          Status: <%= (student.batch.status || 'active').charAt(0).toUpperCase() + (student.batch.status || 'active').slice(1) %>
        </div>
        <div class="text-xs text-slate-500 mt-2 space-y-0.5">
          <% if (student.batch.startDate) { %>
            <div><span class="font-medium text-slate-600">Start Date:</span> <%= new Date(student.batch.startDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
          <% } %>
          <% if (student.batch.endDate) { %>
            <div><span class="font-medium text-slate-600">End Date:</span> <%= new Date(student.batch.endDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
          <% } %>
        </div>
      <% } else { %>
        <div class="text-sm text-slate-400 italic">No batch assigned</div>
      <% } %>
    </div>

    <!-- Lessons -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">
        <svg class="w-4 h-4 text-brand-navy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5v-15Z"/><path d="M8 8h8M8 12h5"/></svg>
        Lessons
      </div>
      <div class="text-3xl font-extrabold text-slate-900"><%= lessonCount %></div>
      <a href="/lessons" class="text-xs text-brand-navy font-semibold hover:underline mt-1 inline-block">View all →</a>
    </div>

    <!-- Joined Date -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">
        <svg class="w-4 h-4 text-brand-navy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        Joined
      </div>
      <div class="text-base font-bold text-slate-900">
        <%= student.joinedDate ? new Date(student.joinedDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %>
      </div>
    </div>
  </div>

  <!-- Announcements -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
        <svg class="w-5 h-5 text-brand-navy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 10v4a1 1 0 0 0 1 1h2l5 4V5L7 9H5a1 1 0 0 0-1 1Z"/><path d="M16 9a3 3 0 0 1 0 6"/></svg>
        Announcements
      </h2>
    </div>
    <% if (announcements && announcements.length > 0) { %>
      <div class="space-y-4">
        <% announcements.forEach(ann => { %>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-semibold text-slate-900 text-sm"><%= ann.title %></h3>
              <span class="text-xs text-slate-400 shrink-0">
                <%= new Date(ann.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
              </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed"><%= ann.content %></p>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="py-8 text-center text-slate-400">
        <svg class="w-10 h-10 mx-auto mb-3 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 10v4a1 1 0 001 1h2l5 4V5L7 9H5a1 1 0 00-1 1zM16 9a3 3 0 010 6"/></svg>
        <p class="text-sm">No announcements yet.</p>
      </div>
    <% } %>
  </div>

</main>

</body>
</html>
