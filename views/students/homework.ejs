<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../partials/head') %></head>
<body class="bg-slate-50 text-slate-800" style="min-height:100svh">

<%- include('../partials/student-nav', { student, activePage: 'Homework' }) %>

<main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 space-y-5 pb-safe lg:pb-8">

  <!-- Flash -->
  <% if (success) { %>
    <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm flex items-center gap-2">
      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span><%= success %></span>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-sm"><%= error %></div>
  <% } %>

  <!-- Header -->
  <div>
    <h1 class="text-2xl font-extrabold text-slate-900">My Homework</h1>
    <p class="text-sm text-slate-500 mt-0.5"><%= homework.length %> assignment<%= homework.length === 1 ? '' : 's' %> assigned</p>
  </div>

  <% if (homework && homework.length > 0) { %>
    <div class="space-y-4">
      <% homework.forEach(hw => {
        const sub = hw.mySubmission;
        const isOverdue = hw.dueDate && new Date(hw.dueDate) < new Date() && !sub;
        const subStatusColors = {
          pending: 'bg-amber-100 text-amber-700',
          review: 'bg-blue-100 text-blue-700',
          approved: 'bg-emerald-100 text-emerald-700',
          rejected: 'bg-red-100 text-red-600',
        };
      %>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="h-1 <%= sub ? (sub.status === 'approved' ? 'bg-emerald-500' : sub.status === 'rejected' ? 'bg-red-400' : 'bg-amber-400') : isOverdue ? 'bg-red-300' : 'bg-brand-navy' %>"></div>

          <div class="p-6">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
              <div>
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <h2 class="font-bold text-slate-900 text-lg"><%= hw.title %></h2>
                  <% if (sub) {
                    const rawStatus = sub?.status || 'pending';
                    const safeStatus = (typeof rawStatus === 'string' && rawStatus.length > 0)
                      ? (rawStatus.charAt(0).toUpperCase() + rawStatus.slice(1).toLowerCase())
                      : 'Pending';
                  %>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold <%= subStatusColors[rawStatus] || subStatusColors.pending %>">
                      <%= safeStatus %>
                    </span>
                  <% } else if (isOverdue) { %>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-600">Overdue</span>
                  <% } else { %>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-500">Not Submitted</span>
                  <% } %>
                </div>

                <div class="flex flex-wrap gap-3 text-xs text-slate-500 mb-2">
                  <% if (hw.lesson) { %><span>Lesson: <span class="font-semibold text-slate-700"><%= hw.lesson.title %></span></span><% } %>
                  <% if (hw.course) { %><span>Course: <span class="font-semibold text-slate-700"><%= hw.course.title %></span></span><% } %>
                  <% if (hw.dueDate) { %>
                    <span class="<%= isOverdue ? 'text-red-500 font-semibold' : '' %>">
                      Due: <%= new Date(hw.dueDate).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %>
                    </span>
                  <% } %>
                </div>

                <% if (hw.description) { %><p class="text-sm text-slate-600 leading-relaxed"><%= hw.description %></p><% } %>

                <!-- Attachments -->
                <% if (hw.attachments && hw.attachments.length > 0) { %>
                  <div class="flex flex-wrap gap-2 mt-3">
                    <% hw.attachments.forEach(att => { %>
                      <a href="<%= att.url %>" target="_blank"
                         class="inline-flex items-center gap-1 px-3 py-1 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg text-xs text-slate-700 transition">
                        📎 <%= att.name %>
                      </a>
                    <% }) %>
                  </div>
                <% } %>

                <!-- Admin Feedback -->
                <% if (sub && (sub.feedback || sub.marks || sub.rating)) { %>
                  <div class="mt-4 p-4 bg-emerald-50 border border-emerald-200 rounded-xl space-y-1">
                    <div class="text-xs font-bold text-emerald-800 uppercase tracking-wider mb-1">Admin Feedback</div>
                    <% if (sub.marks) { %><div class="text-sm font-semibold text-emerald-800">📊 Marks: <%= sub.marks %></div><% } %>
                    <% if (sub.rating) { %><div class="text-sm text-emerald-700">⭐ Rating: <%= sub.rating %>/5</div><% } %>
                    <% if (sub.feedback) { %><div class="text-sm text-emerald-700">💬 <%= sub.feedback %></div><% } %>
                  </div>
                <% } %>

                <!-- Submitted Links Summary -->
                <% if (sub && sub.submissionLinks && sub.submissionLinks.length > 0) { %>
                  <div class="mt-3">
                    <div class="text-xs font-semibold text-slate-500 mb-1">Submitted links (<%= sub.submissionLinks.length %>):</div>
                    <div class="flex flex-wrap gap-2">
                      <% sub.submissionLinks.forEach((link, i) => { %>
                        <a href="<%= link.url %>" target="_blank"
                           class="inline-flex items-center gap-1 px-3 py-1 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 rounded-lg text-xs text-brand-navy transition">
                          🔗 <%= link.label || `Link ${i+1}` %>
                        </a>
                      <% }) %>
                    </div>
                  </div>
                <% } %>
              </div>

              <!-- Submit Button -->
              <div class="shrink-0">
                <a href="/homework/<%= hw._id %>/submit"
                   class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm transition shadow-sm
                     <%= sub ? 'bg-slate-100 hover:bg-slate-200 text-slate-700' : 'bg-brand-navy hover:bg-brand-navyDark text-white' %>">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"/><path d="M22 2L15 22 11 13 2 9l20-7z"/></svg>
                  <%= sub ? 'Edit Submission' : 'Submit' %>
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm py-20 text-center">
      <svg class="w-12 h-12 mx-auto text-slate-300 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
      <p class="text-slate-500 font-medium">No homework assigned yet.</p>
      <p class="text-slate-400 text-sm mt-1">Your homework assignments will appear here.</p>
    </div>
  <% } %>

</main>

</body>
</html>
