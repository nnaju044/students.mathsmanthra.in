<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">
<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Batches' }) %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Batches', pageSubtitle: totalCount + ' total batches' }) %>
    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
        <form method="GET" action="/admin/batches" class="flex items-center gap-3 w-full sm:w-auto">
          <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 w-full sm:w-72">
            <svg class="w-4 h-4 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" name="search" value="<%= search %>" placeholder="Search batches..." class="bg-transparent text-sm placeholder-slate-400 focus:outline-none w-full" />
          </div>
          <button type="submit" class="px-4 py-2.5 bg-brand-navy text-white text-sm font-semibold rounded-xl hover:bg-brand-navyDark transition">Search</button>
        </form>
        <a href="/admin/batches/new" class="flex items-center gap-2 px-5 py-2.5 bg-brand-navy text-white text-sm font-semibold rounded-xl hover:bg-brand-navyDark transition shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
          Create Batch
        </a>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">
              <tr>
                <th class="px-6 py-4">Batch Name</th>
                <th class="px-6 py-4 hidden md:table-cell">Course</th>
                <th class="px-6 py-4 hidden lg:table-cell">Mentor</th>
                <th class="px-6 py-4">Students</th>
                <th class="px-6 py-4">Status</th>
                <th class="px-6 py-4 hidden md:table-cell">Start Date</th>
                <th class="px-6 py-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (batches.length === 0) { %>
                <tr><td colspan="7" class="px-6 py-12 text-center text-slate-400">No batches found. <a href="/admin/batches/new" class="text-brand-navy font-semibold hover:underline">Create your first batch</a>.</td></tr>
              <% } %>
              <% batches.forEach(b => { %>
                <tr class="hover:bg-slate-50/60 transition">
                  <td class="px-6 py-4 font-semibold text-slate-900"><%= b.batchName %></td>
                  <td class="px-6 py-4 text-slate-600 hidden md:table-cell"><%= b.course ? b.course.title : '—' %></td>
                  <td class="px-6 py-4 text-slate-600 hidden lg:table-cell"><%= b.mentor || '—' %></td>
                  <td class="px-6 py-4">
                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200"><%= (b.students || []).length %> students</span>
                  </td>
                  <td class="px-6 py-4">
                    <% const batchStatusColors = { active: 'bg-emerald-50 text-emerald-700 border-emerald-200', completed: 'bg-slate-100 text-slate-600 border-slate-200', upcoming: 'bg-amber-50 text-amber-700 border-amber-200' }; %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold border <%= batchStatusColors[b.status] || batchStatusColors.upcoming %>"><%= b.status %></span>
                  </td>
                  <td class="px-6 py-4 text-slate-500 text-xs hidden md:table-cell"><%= b.startDate ? new Date(b.startDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %></td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <a href="/admin/batches/<%= b._id %>/edit" class="p-2 rounded-lg hover:bg-slate-100 text-slate-500 transition" title="Edit">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                      </a>
                      <form method="POST" action="/admin/batches/<%= b._id %>/delete" onsubmit="return confirm('Delete this batch?');">
                        <button type="submit" class="p-2 rounded-lg hover:bg-red-50 text-red-400 hover:text-red-600 transition" title="Delete">
                          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14Z"/></svg>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <%- include('../../partials/pagination', { currentPage, totalPages, baseUrl: '/admin/batches?' + (search ? 'search=' + search + '&' : '') }) %>

    </main>
    <%- include('../../layouts/footer') %>
  </div>
</div>
</body>
</html>
