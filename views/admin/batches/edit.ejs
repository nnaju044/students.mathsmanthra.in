<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">
<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Batches' }) %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Edit Batch', pageSubtitle: 'Update batch details.' }) %>
    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">
      <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
          <% if (error) { %>
            <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"><%= error %></div>
          <% } %>
          <form method="POST" action="/admin/batches/<%= batch._id %>" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Batch Name <span class="text-red-500">*</span></label>
                <input type="text" name="batchName" required value="<%= batch.batchName %>"
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Course <span class="text-red-500">*</span></label>
                <select name="course" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition">
                  <option value="">Select Course</option>
                  <% courses.forEach(c => { %>
                    <option value="<%= c._id %>" <%= batch.course && batch.course.toString() === c._id.toString() ? 'selected' : '' %>><%= c.title %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Mentor / Instructor</label>
              <input type="text" name="mentor" value="<%= batch.mentor || '' %>"
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Start Date <span class="text-red-500">*</span></label>
                <input type="date" name="startDate" required value="<%= batch.startDate ? new Date(batch.startDate).toISOString().split('T')[0] : '' %>"
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">End Date</label>
                <input type="date" name="endDate" value="<%= batch.endDate ? new Date(batch.endDate).toISOString().split('T')[0] : '' %>"
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition" />
              </div>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Status</label>
              <select name="status" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition">
                <option value="upcoming" <%= batch.status === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
                <option value="active" <%= batch.status === 'active' ? 'selected' : '' %>>Active</option>
                <option value="completed" <%= batch.status === 'completed' ? 'selected' : '' %>>Completed</option>
              </select>
            </div>
            <% if (students.length > 0) { %>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Assign Students</label>
              <div class="border border-slate-200 rounded-xl bg-slate-50 max-h-48 overflow-y-auto p-3 space-y-2">
                <% students.forEach(s => { %>
                  <% const isAssigned = batch.students && batch.students.some(id => id && id.toString() === s._id.toString()); %>
                  <label class="flex items-center gap-3 cursor-pointer hover:bg-white rounded-lg px-2 py-1.5 transition">
                    <input type="checkbox" name="students" value="<%= s._id %>" <%= isAssigned ? 'checked' : '' %> class="rounded border-slate-300 text-brand-navy focus:ring-brand-navy" />
                    <span class="text-sm text-slate-700"><%= s.name %> <span class="text-slate-400 text-xs">— <%= s.phone %></span></span>
                  </label>
                <% }) %>
              </div>
            </div>
            <% } %>
            <div class="flex items-center justify-end gap-3 pt-2">
              <a href="/admin/batches" class="px-5 py-3 text-sm font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition">Cancel</a>
              <button type="submit" class="px-6 py-3 bg-brand-navy hover:bg-brand-navyDark text-white font-bold text-sm rounded-xl shadow-sm transition">Save Changes</button>
            </div>
          </form>
        </div>
      </div>
    </main>
    <%- include('../../layouts/footer') %>
  </div>
</div>
</body>
</html>
