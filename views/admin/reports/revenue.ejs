<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">
<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Reports' }) %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Revenue Report', pageSubtitle: 'Last 12 months overview' }) %>
    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">

      <!-- Top Bar -->
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <a href="/admin/reports/student-growth" class="px-4 py-2 text-sm text-slate-600 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 transition">Student Growth</a>
          <a href="/admin/reports/attendance" class="px-4 py-2 text-sm text-slate-600 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 transition">Attendance</a>
        </div>
        <a href="/admin/reports/revenue/export"
           class="flex items-center gap-2 px-5 py-2.5 bg-indigo-600 text-white text-sm font-semibold rounded-xl hover:bg-indigo-700 transition shadow-sm">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Export XLSX
        </a>
      </div>

      <!-- Chart -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-6">
        <h3 class="text-sm font-semibold text-slate-600 mb-4">Monthly Revenue Trend (Last 12 Months)</h3>
        <canvas id="revenueChart" height="100"></canvas>
      </div>

      <!-- Table -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">
              <tr>
                <th class="px-6 py-4">Month</th>
                <th class="px-6 py-4">Total Revenue</th>
                <th class="px-6 py-4">Paid Students</th>
                <th class="px-6 py-4">Pending</th>
                <th class="px-6 py-4">Overdue</th>
                <th class="px-6 py-4">Avg / Student</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% monthsData.forEach((row, idx) => { %>
              <tr class="hover:bg-slate-50/60 transition">
                <td class="px-6 py-4 font-semibold text-slate-800"><%= row.month %></td>
                <td class="px-6 py-4 font-bold text-indigo-700">₹<%= row.totalRevenue.toLocaleString('en-IN') %></td>
                <td class="px-6 py-4 text-emerald-700 font-semibold"><%= row.paidStudents %></td>
                <td class="px-6 py-4 text-amber-700"><%= row.pendingStudents %></td>
                <td class="px-6 py-4 text-red-600"><%= row.overdueStudents %></td>
                <td class="px-6 py-4 text-slate-600">₹<%= row.avgRevenuePerStudent.toLocaleString('en-IN') %></td>
              </tr>
              <% }) %>
            </tbody>
            <tfoot class="bg-indigo-50 border-t-2 border-indigo-200">
              <tr>
                <td class="px-6 py-4 font-bold text-indigo-900">TOTAL</td>
                <td class="px-6 py-4 font-bold text-indigo-700">₹<%= monthsData.reduce((s,r) => s + r.totalRevenue, 0).toLocaleString('en-IN') %></td>
                <td class="px-6 py-4 font-bold text-emerald-700"><%= monthsData.reduce((s,r) => s + r.paidStudents, 0) %></td>
                <td class="px-6 py-4 font-bold text-amber-700"><%= monthsData.reduce((s,r) => s + r.pendingStudents, 0) %></td>
                <td class="px-6 py-4 font-bold text-red-600"><%= monthsData.reduce((s,r) => s + r.overdueStudents, 0) %></td>
                <td class="px-6 py-4 text-slate-500">—</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

    </main>
    <%- include('../../layouts/footer') %>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
  const ctx = document.getElementById('revenueChart').getContext('2d');
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: <%- chartLabels %>,
      datasets: [{
        label: 'Revenue (₹)',
        data: <%- chartData %>,
        backgroundColor: 'rgba(99,102,241,0.15)',
        borderColor: '#6366f1',
        borderWidth: 2,
        borderRadius: 6,
        fill: true,
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            callback: (v) => '₹' + v.toLocaleString('en-IN'),
            color: '#64748b', font: { size: 11 }
          },
          grid: { color: '#f1f5f9' }
        },
        x: { ticks: { color: '#64748b', font: { size: 11 } }, grid: { display: false } }
      }
    }
  });
</script>
</body>
</html>
