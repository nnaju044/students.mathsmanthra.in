<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">
<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Reports' }) %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Attendance Report', pageSubtitle: monthLabel }) %>
    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">

      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <a href="/admin/reports/revenue" class="px-4 py-2 text-sm text-slate-600 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 transition">Revenue</a>
          <a href="/admin/reports/student-growth" class="px-4 py-2 text-sm text-slate-600 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 transition">Student Growth</a>
        </div>
        <a href="/admin/reports/attendance/export"
           class="flex items-center gap-2 px-5 py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl hover:bg-sky-700 transition shadow-sm">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Export XLSX
        </a>
      </div>

      <% if (records.length === 0) { %>
        <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center text-slate-400">
          No attendance records found for <%= monthLabel %>.
        </div>
      <% } else { %>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">
              <tr>
                <th class="px-6 py-4">Student Name</th>
                <th class="px-6 py-4">Course</th>
                <th class="px-6 py-4">Batch</th>
                <th class="px-6 py-4 text-center">Present</th>
                <th class="px-6 py-4 text-center">Absent</th>
                <th class="px-6 py-4 text-center">Late</th>
                <th class="px-6 py-4 text-center">Attendance %</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% records.forEach(row => { %>
              <tr class="hover:bg-slate-50/60 transition">
                <td class="px-6 py-4 font-semibold text-slate-800"><%= row.studentName %></td>
                <td class="px-6 py-4 text-slate-600"><%= row.course %></td>
                <td class="px-6 py-4 text-slate-600"><%= row.batch %></td>
                <td class="px-6 py-4 text-center text-emerald-700 font-semibold"><%= row.present %></td>
                <td class="px-6 py-4 text-center text-red-600"><%= row.absent %></td>
                <td class="px-6 py-4 text-center text-amber-600"><%= row.late %></td>
                <td class="px-6 py-4 text-center">
                  <% const pct = row.attendancePercent; %>
                  <span class="px-2.5 py-1 rounded-full text-xs font-bold border
                    <%= pct >= 75 ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : pct >= 50 ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-red-50 text-red-700 border-red-200' %>">
                    <%= pct %>%
                  </span>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

    </main>
    <%- include('../../layouts/footer') %>
  </div>
</div>
</body>
</html>
