<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">

<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Attendance' }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Attendance Records', pageSubtitle: 'View monthly attendance and student percentages.' }) %>

    <main class="flex-1 px-6 sm:px-8 py-8 space-y-6 overflow-y-auto">

      <!-- Back -->
      <a href="/admin/attendance" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-brand-navy transition font-medium">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Back to Attendance
      </a>

      <!-- Filters -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h2 class="text-lg font-bold text-slate-900 mb-4">Filter Attendance Records</h2>
        <form method="GET" action="/admin/attendance/view" class="flex flex-col sm:flex-row gap-3">
          <select name="batchId" class="flex-1 px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
            <option value="">— Select Batch —</option>
            <% batches.forEach(b => { %>
              <option value="<%= b._id %>" <%= batchId === b._id.toString() ? 'selected' : '' %>><%= b.batchName %> <%= b.course ? `— ${b.course.title}` : '' %></option>
            <% }) %>
          </select>
          <input type="month" name="month" value="<%= month || new Date().toISOString().slice(0,7) %>"
                 class="flex-1 px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
          <button type="submit" class="px-6 py-3 bg-brand-navy hover:bg-brand-navyDark text-white font-semibold text-sm rounded-xl transition">
            View Records
          </button>
        </form>
      </div>

      <% if (batch && studentStats.length > 0) { %>
        <!-- Summary -->
        <div class="bg-brand-navy rounded-2xl p-6 flex flex-col sm:flex-row gap-4 sm:items-center justify-between">
          <div>
            <h2 class="text-xl font-extrabold text-white"><%= batch.batchName %></h2>
            <p class="text-indigo-300 text-sm mt-0.5"><%= month ? new Date(month + '-01').toLocaleDateString('en-IN', {month:'long',year:'numeric'}) : 'This Month' %></p>
          </div>
          <div class="flex gap-4">
            <div class="bg-white/10 rounded-xl px-4 py-3 text-center">
              <div class="text-2xl font-extrabold text-white"><%= studentStats.length %></div>
              <div class="text-xs text-indigo-300 font-medium">Students</div>
            </div>
            <div class="bg-white/10 rounded-xl px-4 py-3 text-center">
              <div class="text-2xl font-extrabold text-emerald-300"><%= Math.round(studentStats.reduce((s,x) => s + x.percentage, 0) / studentStats.length) || 0 %>%</div>
              <div class="text-xs text-indigo-300 font-medium">Avg Attendance</div>
            </div>
          </div>
        </div>

        <!-- Student Attendance Table -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                  <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Student</th>
                  <th class="px-4 py-4 text-center text-xs font-semibold text-emerald-600 uppercase tracking-wider">Present</th>
                  <th class="px-4 py-4 text-center text-xs font-semibold text-amber-600 uppercase tracking-wider">Late</th>
                  <th class="px-4 py-4 text-center text-xs font-semibold text-red-500 uppercase tracking-wider">Absent</th>
                  <th class="px-4 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Days</th>
                  <th class="px-4 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Attendance %</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% studentStats.forEach(s => { %>
                  <tr class="hover:bg-slate-50 transition">
                    <td class="px-6 py-4">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-brand-navy text-white flex items-center justify-center font-bold text-xs shrink-0">
                          <%= (s?.student?.name || 'S').charAt(0).toUpperCase() %>
                        </div>
                        <div>
                          <div class="font-semibold text-slate-900"><%= s?.student?.name || 'Unknown Student' %></div>
                          <div class="text-xs text-slate-400"><%= s?.student?.email || s?.student?.phone || '' %></div>
                        </div>
                      </div>
                    </td>
                    <td class="px-4 py-4 text-center font-bold text-emerald-600"><%= s.present %></td>
                    <td class="px-4 py-4 text-center font-bold text-amber-600"><%= s.late %></td>
                    <td class="px-4 py-4 text-center font-bold text-red-500"><%= s.absent %></td>
                    <td class="px-4 py-4 text-center text-slate-600"><%= s.total %></td>
                    <td class="px-4 py-4">
                      <div class="flex items-center justify-center gap-2">
                        <div class="flex-1 max-w-24 bg-slate-200 rounded-full h-2">
                          <div class="h-2 rounded-full transition-all
                            <%= s.percentage >= 75 ? 'bg-emerald-500' : s.percentage >= 50 ? 'bg-amber-400' : 'bg-red-400' %>"
                               style="width: <%= Math.min(s.percentage, 100) %>%"></div>
                        </div>
                        <span class="font-bold text-sm <%= s.percentage >= 75 ? 'text-emerald-600' : s.percentage >= 50 ? 'text-amber-600' : 'text-red-500' %>">
                          <%= s.percentage %>%
                        </span>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } else if (batchId) { %>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm py-16 text-center">
          <p class="text-slate-500 font-medium">No attendance records found for the selected batch and month.</p>
        </div>
      <% } %>

    </main>
  </div>
</div>

<%- include('../../layouts/footer') %>
</body>
</html>
