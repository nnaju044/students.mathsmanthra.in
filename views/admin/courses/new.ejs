<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">
<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Courses' }) %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Add New Course', pageSubtitle: 'Create a new mathematics course.' }) %>
    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">
      <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
          <% if (error) { %>
            <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"><%= error %></div>
          <% } %>
          <form method="POST" action="/admin/courses" class="space-y-5">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Course Title <span class="text-red-500">*</span></label>
              <input type="text" name="title" required placeholder="e.g. SSLC Mathematics Foundation"
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Description</label>
              <textarea name="description" rows="3" placeholder="Brief description of the course..."
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition resize-none"></textarea>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Duration</label>
                <input type="text" name="duration" placeholder="e.g. 3 Months"
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Fee (₹)</label>
                <input type="number" name="price" min="0" step="1" placeholder="e.g. 1999"
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Status</label>
                <select name="status" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition">
                  <option value="active">Active</option>
                  <option value="draft">Draft</option>
                  <option value="inactive">Inactive</option>
                </select>
              </div>
            </div>
            <div class="flex items-center justify-end gap-3 pt-2">
              <a href="/admin/courses" class="px-5 py-3 text-sm font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition">Cancel</a>
              <button type="submit" class="px-6 py-3 bg-brand-navy hover:bg-brand-navyDark text-white font-bold text-sm rounded-xl shadow-sm transition">Create Course</button>
            </div>
          </form>
        </div>
      </div>
    </main>
    <%- include('../../layouts/footer') %>
  </div>
</div>
</body>
</html>
