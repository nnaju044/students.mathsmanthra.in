<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">
<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Audit' }) %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Audit Logs', pageSubtitle: totalCount + ' total events' }) %>
    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">

      <!-- Filters -->
      <form method="GET" action="/admin/audit-logs" class="bg-white rounded-2xl border border-slate-200 p-4 mb-6 flex flex-wrap items-center gap-3">
        <select name="action" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-600 focus:outline-none">
          <option value="">All Actions</option>
          <% actionTypes.forEach(a => { %>
            <option value="<%= a %>" <%= filters.action === a ? 'selected' : '' %>><%= a.replace(/_/g, ' ') %></option>
          <% }) %>
        </select>
        <select name="entityType" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-600 focus:outline-none">
          <option value="">All Entities</option>
          <% entityTypes.forEach(e => { %>
            <option value="<%= e %>" <%= filters.entityType === e ? 'selected' : '' %>><%= e %></option>
          <% }) %>
        </select>
        <input type="date" name="date" value="<%= filters.date || '' %>"
               class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-600 focus:outline-none" />
        <button type="submit" class="px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-xl hover:bg-indigo-700 transition">Filter</button>
        <a href="/admin/audit-logs" class="px-4 py-2 text-sm text-slate-500 hover:text-slate-700 transition">Clear</a>
      </form>

      <!-- Log Table -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">
              <tr>
                <th class="px-6 py-4">Time</th>
                <th class="px-6 py-4">Admin</th>
                <th class="px-6 py-4">Action</th>
                <th class="px-6 py-4">Entity</th>
                <th class="px-6 py-4">Name</th>
                <th class="px-6 py-4">IP Address</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (logs.length === 0) { %>
                <tr><td colspan="6" class="px-6 py-12 text-center text-slate-400">No audit logs found for the selected filters.</td></tr>
              <% } %>
              <% logs.forEach(log => { %>
              <%
                const actionColors = {
                  CREATE_STUDENT: 'text-emerald-700 bg-emerald-50', EDIT_STUDENT: 'text-blue-700 bg-blue-50', DELETE_STUDENT: 'text-red-700 bg-red-50',
                  CREATE_COURSE: 'text-emerald-700 bg-emerald-50', EDIT_COURSE: 'text-blue-700 bg-blue-50', DELETE_COURSE: 'text-red-700 bg-red-50',
                  RECORD_PAYMENT: 'text-amber-700 bg-amber-50', DELETE_PAYMENT: 'text-red-700 bg-red-50',
                  ADMIN_LOGIN: 'text-indigo-700 bg-indigo-50', ADMIN_LOGOUT: 'text-slate-700 bg-slate-100',
                  MARK_ATTENDANCE: 'text-teal-700 bg-teal-50',
                };
                const colorClass = actionColors[log.action] || 'text-slate-700 bg-slate-100';
              %>
              <tr class="hover:bg-slate-50/60 transition">
                <td class="px-6 py-3 text-xs text-slate-500 whitespace-nowrap">
                  <%= new Date(log.createdAt).toLocaleString('en-IN', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
                </td>
                <td class="px-6 py-3 text-sm font-medium text-slate-700"><%= log.adminName || 'System' %></td>
                <td class="px-6 py-3">
                  <span class="px-2 py-0.5 rounded-md text-xs font-semibold <%= colorClass %>">
                    <%= (log.action || '').replace(/_/g, ' ') %>
                  </span>
                </td>
                <td class="px-6 py-3 text-sm text-slate-600"><%= log.entityType || '—' %></td>
                <td class="px-6 py-3 text-sm text-slate-800 font-medium"><%= log.entityName || '—' %></td>
                <td class="px-6 py-3 text-xs font-mono text-slate-400"><%= log.ipAddress || '—' %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
      <div class="flex items-center justify-center gap-2 mt-6">
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="?page=<%= i %>&action=<%= filters.action || '' %>&entityType=<%= filters.entityType || '' %>&date=<%= filters.date || '' %>"
             class="px-3 py-1.5 text-sm rounded-lg border transition <%= i === currentPage ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
            <%= i %>
          </a>
        <% } %>
      </div>
      <% } %>

    </main>
    <%- include('../../layouts/footer') %>
  </div>
</div>
</body>
</html>
