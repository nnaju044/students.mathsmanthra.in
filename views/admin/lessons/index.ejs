<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">
<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Lessons' }) %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Lessons', pageSubtitle: totalCount + ' total lessons' }) %>
    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
        <form method="GET" action="/admin/lessons" class="flex items-center gap-3 w-full sm:w-auto">
          <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 w-full sm:w-72">
            <svg class="w-4 h-4 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" name="search" value="<%= search %>" placeholder="Search lessons..." class="bg-transparent text-sm placeholder-slate-400 focus:outline-none w-full" />
          </div>
          <button type="submit" class="px-4 py-2.5 bg-brand-navy text-white text-sm font-semibold rounded-xl hover:bg-brand-navyDark transition">Search</button>
        </form>
        <a href="/admin/lessons/new" class="flex items-center gap-2 px-5 py-2.5 bg-brand-navy text-white text-sm font-semibold rounded-xl hover:bg-brand-navyDark transition shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
          Add Lesson
        </a>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">
              <tr>
                <th class="px-6 py-4">Title</th>
                <th class="px-6 py-4 hidden md:table-cell">Course</th>
                <th class="px-6 py-4 hidden lg:table-cell">Order</th>
                <th class="px-6 py-4 hidden md:table-cell">Video</th>
                <th class="px-6 py-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (lessons.length === 0) { %>
                <tr><td colspan="5" class="px-6 py-12 text-center text-slate-400">No lessons found. <a href="/admin/lessons/new" class="text-brand-navy font-semibold hover:underline">Add your first lesson</a>.</td></tr>
              <% } %>
              <% lessons.forEach(l => { %>
                <tr class="hover:bg-slate-50/60 transition">
                  <td class="px-6 py-4">
                    <div class="font-medium text-slate-900"><%= l.title %></div>
                    <% if (l.description) { %><div class="text-xs text-slate-400 truncate max-w-xs"><%= l.description %></div><% } %>
                  </td>
                  <td class="px-6 py-4 text-slate-600 hidden md:table-cell"><%= l.course ? l.course.title : '—' %></td>
                  <td class="px-6 py-4 text-slate-500 hidden lg:table-cell"># <%= l.order || 0 %></td>
                  <td class="px-6 py-4 hidden md:table-cell">
                    <% if (l.videoUrl) { %>
                      <a href="<%= l.videoUrl %>" target="_blank" class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-800 transition">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg> Watch
                      </a>
                    <% } else { %>
                      <span class="text-slate-400 text-xs">No video</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <a href="/admin/lessons/<%= l._id %>/edit" class="p-2 rounded-lg hover:bg-slate-100 text-slate-500 transition" title="Edit">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                      </a>
                      <form method="POST" action="/admin/lessons/<%= l._id %>/delete" onsubmit="return confirm('Delete this lesson?');">
                        <button type="submit" class="p-2 rounded-lg hover:bg-red-50 text-red-400 hover:text-red-600 transition" title="Delete">
                          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14Z"/></svg>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <%- include('../../partials/pagination', { currentPage, totalPages, baseUrl: '/admin/lessons?' + (search ? 'search=' + search + '&' : '') }) %>

    </main>
    <%- include('../../layouts/footer') %>
  </div>
</div>
</body>
</html>
