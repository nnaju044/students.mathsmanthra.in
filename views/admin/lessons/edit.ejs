<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">

<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Lessons' }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Edit Lesson', pageSubtitle: 'Update lesson details and class information.' }) %>

    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">
      <div class="max-w-3xl mx-auto">
        <div class="mb-6">
          <a href="/admin/lessons" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-brand-navy transition font-medium">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Back to Lessons
          </a>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
          <h1 class="text-2xl font-extrabold text-slate-900 mb-6">Edit Lesson</h1>

          <% if (error) { %>
            <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"><%= error %></div>
          <% } %>

          <form method="POST" action="/admin/lessons/<%= lesson._id %>" enctype="multipart/form-data" class="space-y-5">

            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Lesson Title <span class="text-red-500">*</span></label>
              <input type="text" name="title" value="<%= lesson.title %>" required
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Course <span class="text-red-500">*</span></label>
                <select name="course" required class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                  <option value="">— Select course —</option>
                  <% courses.forEach(c => { %>
                    <option value="<%= c._id %>" <%= lesson.course?.toString() === c._id.toString() ? 'selected' : '' %>><%= c.title %></option>
                  <% }) %>
                </select>
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Batch</label>
                <select name="batch" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                  <option value="">— All batches —</option>
                  <% batches.forEach(b => { %>
                    <option value="<%= b._id %>" <%= lesson.batch?.toString() === b._id.toString() ? 'selected' : '' %>><%= b.batchName %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Lesson Date</label>
                <input type="date" name="lessonDate"
                       value="<%= lesson.lessonDate ? new Date(lesson.lessonDate).toISOString().split('T')[0] : '' %>"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Time</label>
                <input type="time" name="lessonTime" value="<%= lesson.lessonTime || '' %>"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Status</label>
                <select name="status" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                  <option value="upcoming" <%= lesson.status === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
                  <option value="live" <%= lesson.status === 'live' ? 'selected' : '' %>>🔴 Live</option>
                  <option value="completed" <%= lesson.status === 'completed' ? 'selected' : '' %>>Completed</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Google Meet Link</label>
              <input type="url" name="meetLink" value="<%= lesson.meetLink || '' %>"
                     placeholder="https://meet.google.com/xxx-xxxx-xxx"
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
            </div>

            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Description</label>
              <textarea name="description" rows="3"
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30 resize-none"><%= lesson.description %></textarea>
            </div>

            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Homework Instructions</label>
              <textarea name="homeworkDescription" rows="2"
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30 resize-none"><%= lesson.homeworkDescription || '' %></textarea>
            </div>

            <!-- Existing PDF Materials -->
            <% if (lesson.pdfMaterials && lesson.pdfMaterials.length > 0) { %>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Existing PDF Materials</label>
                <div class="space-y-2">
                  <% lesson.pdfMaterials.forEach(pdf => { %>
                    <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200">
                      <svg class="w-5 h-5 text-red-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
                      <a href="<%= pdf.url %>" target="_blank" class="text-sm text-brand-navy hover:underline flex-1"><%= pdf.name %></a>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <!-- Add More PDFs -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Add More PDF Materials</label>
              <input type="file" name="pdfMaterials" multiple accept=".pdf,.doc,.docx,.ppt,.pptx"
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm"/>
            </div>

            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Display Order</label>
              <input type="number" name="order" value="<%= lesson.order || 0 %>" min="0"
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
            </div>

            <div class="flex gap-3 pt-2">
              <button type="submit" class="flex-1 py-3 bg-brand-navy hover:bg-brand-navyDark text-white font-semibold text-sm rounded-xl transition">
                Update Lesson
              </button>
              <a href="/admin/lessons" class="flex-1 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm rounded-xl transition text-center">
                Cancel
              </a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../../layouts/footer') %>
</body>
</html>
