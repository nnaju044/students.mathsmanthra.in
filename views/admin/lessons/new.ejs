<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">

<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Lessons' }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Add Lesson', pageSubtitle: 'Create a new lesson with live class details.' }) %>

    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">
      <div class="max-w-3xl mx-auto">
        <div class="mb-6">
          <a href="/admin/lessons" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-brand-navy transition font-medium">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Back to Lessons
          </a>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
          <h1 class="text-2xl font-extrabold text-slate-900 mb-6">Create Lesson</h1>

          <% if (error) { %>
            <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"><%= error %></div>
          <% } %>

          <form method="POST" action="/admin/lessons" enctype="multipart/form-data" class="space-y-5">

            <!-- Title -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Lesson Title <span class="text-red-500">*</span></label>
              <input type="text" name="title" required placeholder="e.g., Introduction to Algebra"
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
            </div>

            <!-- Course & Batch -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Course <span class="text-red-500">*</span></label>
                <select name="course" required class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                  <option value="">— Select course —</option>
                  <% courses.forEach(c => { %>
                    <option value="<%= c._id %>"><%= c.title %></option>
                  <% }) %>
                </select>
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Batch</label>
                <select name="batch" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                  <option value="">— All batches —</option>
                  <% batches.forEach(b => { %>
                    <option value="<%= b._id %>"><%= b.batchName %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <!-- Date, Time, Status -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Lesson Date</label>
                <input type="date" name="lessonDate"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Time</label>
                <input type="time" name="lessonTime"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Status</label>
                <select name="status" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                  <option value="upcoming">Upcoming</option>
                  <option value="live">🔴 Live</option>
                  <option value="completed">Completed</option>
                </select>
              </div>
            </div>

            <!-- Google Meet Link -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">
                <svg class="w-4 h-4 inline mr-1 text-blue-500" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h16v16H4z" fill="none"/><path d="M15 8l-3 2.5L9 8v8l3-2.5 3 2.5V8z"/><rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
                Google Meet Link
              </label>
              <input type="url" name="meetLink" placeholder="https://meet.google.com/xxx-xxxx-xxx"
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
            </div>

            <!-- Description -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Description</label>
              <textarea name="description" rows="3" placeholder="Lesson overview..."
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30 resize-none"></textarea>
            </div>

            <!-- Homework Description -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Homework Instructions (optional)</label>
              <textarea name="homeworkDescription" rows="2" placeholder="Describe the homework for this lesson..."
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30 resize-none"></textarea>
            </div>

            <!-- PDF Materials -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">PDF Materials</label>
              <input type="file" name="pdfMaterials" multiple accept=".pdf,.doc,.docx,.ppt,.pptx"
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm"/>
              <p class="text-xs text-slate-400 mt-1">PDF, Word, PowerPoint files. Max 30MB each.</p>
            </div>

            <!-- Order -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Display Order</label>
              <input type="number" name="order" value="0" min="0"
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
            </div>

            <div class="flex gap-3 pt-2">
              <button type="submit" class="flex-1 py-3 bg-brand-navy hover:bg-brand-navyDark text-white font-semibold text-sm rounded-xl transition">
                Create Lesson
              </button>
              <a href="/admin/lessons" class="flex-1 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm rounded-xl transition text-center">
                Cancel
              </a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../../layouts/footer') %>
</body>
</html>
