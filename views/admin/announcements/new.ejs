<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">

<%
  const coursesSafe = typeof courses !== 'undefined' && Array.isArray(courses) ? courses : [];
  const batchesSafe = typeof batches !== 'undefined' && Array.isArray(batches) ? batches : [];
  const studentsSafe = typeof students !== 'undefined' && Array.isArray(students) ? students : [];
  const errorSafe = typeof error !== 'undefined' ? error : null;
%>

<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Announcements' }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'New Announcement', pageSubtitle: 'Post a targeted message to students.' }) %>

    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">
      <div class="max-w-2xl mx-auto">
        <div class="mb-6">
          <a href="/admin/announcements" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-brand-navy transition font-medium">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Back to Announcements
          </a>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
          <h1 class="text-2xl font-extrabold text-slate-900 mb-6">Create Announcement</h1>

          <% if (errorSafe) { %>
            <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"><%= errorSafe %></div>
          <% } %>

          <form method="POST" action="/admin/announcements" class="space-y-5">

            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Title <span class="text-red-500">*</span></label>
              <input type="text" name="title" required placeholder="Announcement title..."
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
            </div>

            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Content <span class="text-red-500">*</span></label>
              <textarea name="content" rows="5" required placeholder="Write your announcement..."
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30 resize-none"></textarea>
            </div>

            <!-- Target Audience -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Target Audience</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="targetTypeGroup">
                <label class="flex items-center gap-2 p-3 rounded-xl border-2 border-brand-navy bg-indigo-50 cursor-pointer target-option">
                  <input type="radio" name="targetAudience" value="all" checked onchange="showTargetField(this)"
                         class="w-4 h-4 accent-brand-navy"/>
                  <span class="text-sm font-semibold text-brand-navy">🌐 All</span>
                </label>
                <label class="flex items-center gap-2 p-3 rounded-xl border-2 border-slate-200 cursor-pointer target-option">
                  <input type="radio" name="targetAudience" value="course" onchange="showTargetField(this)"
                         class="w-4 h-4 accent-brand-navy"/>
                  <span class="text-sm font-semibold text-slate-700">📚 Course</span>
                </label>
                <label class="flex items-center gap-2 p-3 rounded-xl border-2 border-slate-200 cursor-pointer target-option">
                  <input type="radio" name="targetAudience" value="batch" onchange="showTargetField(this)"
                         class="w-4 h-4 accent-brand-navy"/>
                  <span class="text-sm font-semibold text-slate-700">📦 Batch</span>
                </label>
                <label class="flex items-center gap-2 p-3 rounded-xl border-2 border-slate-200 cursor-pointer target-option">
                  <input type="radio" name="targetAudience" value="student" onchange="showTargetField(this)"
                         class="w-4 h-4 accent-brand-navy"/>
                  <span class="text-sm font-semibold text-slate-700">👤 Student</span>
                </label>
              </div>
            </div>

            <!-- Conditional Target Dropdowns -->
            <div id="targetCourseField" class="hidden">
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Select Course</label>
              <select name="targetCourse" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                <option value="">— Select course —</option>
                <% coursesSafe.forEach(c => { %><option value="<%= c._id %>"><%= c.title %></option><% }) %>
              </select>
            </div>

            <div id="targetBatchField" class="hidden">
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Select Batch</label>
              <select name="targetBatch" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                <option value="">— Select batch —</option>
                <% batchesSafe.forEach(b => { %><option value="<%= b._id %>"><%= b.batchName %></option><% }) %>
              </select>
            </div>

            <div id="targetStudentField" class="hidden">
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Select Student</label>
              <select name="targetStudent" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                <option value="">— Select student —</option>
                <% studentsSafe.forEach(s => { %><option value="<%= s._id %>"><%= s.name %> (<%= s.email || s.phone %>)</option><% }) %>
              </select>
            </div>

            <!-- Status -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Status</label>
              <select name="status" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                <option value="published">Published (visible immediately)</option>
                <option value="draft" selected>Draft (hidden from students)</option>
              </select>
            </div>

            <div class="flex gap-3 pt-2">
              <button type="submit" class="flex-1 py-3 bg-brand-navy hover:bg-brand-navyDark text-white font-semibold text-sm rounded-xl transition">
                Post Announcement
              </button>
              <a href="/admin/announcements" class="flex-1 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm rounded-xl transition text-center">
                Cancel
              </a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../../layouts/footer') %>

<script>
function showTargetField(radio) {
  document.querySelectorAll('.target-option').forEach(el => {
    el.classList.remove('border-brand-navy', 'bg-indigo-50');
    el.classList.add('border-slate-200');
  });
  radio.closest('.target-option').classList.add('border-brand-navy', 'bg-indigo-50');
  radio.closest('.target-option').classList.remove('border-slate-200');

  ['targetCourseField', 'targetBatchField', 'targetStudentField'].forEach(id => {
    document.getElementById(id).classList.add('hidden');
  });

  const map = { course: 'targetCourseField', batch: 'targetBatchField', student: 'targetStudentField' };
  if (map[radio.value]) document.getElementById(map[radio.value]).classList.remove('hidden');
}
</script>
</body>
</html>
