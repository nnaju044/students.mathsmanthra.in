<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">

<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Homework' }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Create Homework', pageSubtitle: 'Add a new homework assignment.' }) %>

    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">
      <div class="max-w-2xl mx-auto">
        <div class="mb-6">
          <a href="/admin/homework" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-brand-navy transition font-medium">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Back to Homework
          </a>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
          <h1 class="text-2xl font-extrabold text-slate-900 mb-6">Add Homework Assignment</h1>

          <% if (error) { %>
            <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"><%= error %></div>
          <% } %>

          <form method="POST" action="/admin/homework" enctype="multipart/form-data" class="space-y-5">

            <!-- Title -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Homework Title <span class="text-red-500">*</span></label>
              <input type="text" name="title" required placeholder="e.g., Chapter 3 Practice Problems"
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
            </div>

            <!-- Lesson -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Lesson <span class="text-red-500">*</span></label>
              <select name="lesson" required id="lessonSelect" onchange="autoFillFromLesson(this)"
                      class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                <option value="">— Select a lesson —</option>
                <% lessons.forEach(l => { %>
                  <option value="<%= l._id %>"
                          data-course="<%= l.course?._id || '' %>"
                          data-batch="<%= l.batch || '' %>">
                    <%= l.title %> <%= l.course ? `(${l.course.title})` : '' %>
                    <%= l.lessonDate ? ` — ${new Date(l.lessonDate).toLocaleDateString('en-IN', {day:'numeric',month:'short'})}` : '' %>
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Course & Batch -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Course</label>
                <select name="course" id="courseSelect"
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                  <option value="">— All courses —</option>
                  <% courses.forEach(c => { %>
                    <option value="<%= c._id %>"><%= c.title %></option>
                  <% }) %>
                </select>
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Batch</label>
                <select name="batch" id="batchSelect"
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                  <option value="">— All batches —</option>
                  <% batches.forEach(b => { %>
                    <option value="<%= b._id %>"><%= b.batchName %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <!-- Description -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Description</label>
              <textarea name="description" rows="4" placeholder="Describe what students need to do..."
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30 resize-none"></textarea>
            </div>

            <!-- Due Date & Status -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Due Date</label>
                <input type="date" name="dueDate"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Status</label>
                <select name="status" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                  <option value="active">Active</option>
                  <option value="closed">Closed</option>
                </select>
              </div>
            </div>

            <!-- Attachments -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Attachments (optional)</label>
              <input type="file" name="attachments" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx"
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
              <p class="text-xs text-slate-400 mt-1">PDF, images, Word documents. Max 20MB each.</p>
            </div>

            <!-- Submit -->
            <div class="flex gap-3 pt-2">
              <button type="submit"
                      class="flex-1 py-3 bg-brand-navy hover:bg-brand-navyDark text-white font-semibold text-sm rounded-xl transition">
                Create Homework
              </button>
              <a href="/admin/homework"
                 class="flex-1 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm rounded-xl transition text-center">
                Cancel
              </a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../../layouts/footer') %>

<script>
function autoFillFromLesson(select) {
  const opt = select.options[select.selectedIndex];
  const courseId = opt.dataset.course;
  const batchId = opt.dataset.batch;
  if (courseId) {
    const courseSelect = document.getElementById('courseSelect');
    for (let o of courseSelect.options) { if (o.value === courseId) { courseSelect.value = courseId; break; } }
  }
  if (batchId) {
    const batchSelect = document.getElementById('batchSelect');
    for (let o of batchSelect.options) { if (o.value === batchId) { batchSelect.value = batchId; break; } }
  }
}
</script>
</body>
</html>
