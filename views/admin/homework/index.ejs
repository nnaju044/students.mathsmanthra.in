<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">

<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Homework' }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Homework Management', pageSubtitle: 'Create and manage homework assignments.' }) %>

    <main class="flex-1 px-6 sm:px-8 py-8 space-y-6 overflow-y-auto">

      <!-- Flash Messages -->
      <% if (success) { %>
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span><%= success %></span>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- Header Row -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl font-extrabold text-slate-900">Homework Assignments</h1>
          <p class="text-sm text-slate-500 mt-0.5"><%= totalCount %> total assignments</p>
        </div>
        <a href="/admin/homework/new"
           class="flex items-center gap-2 bg-brand-navy hover:bg-brand-navyDark text-white font-semibold text-sm px-5 py-2.5 rounded-xl transition shadow-sm">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          Add Homework
        </a>
      </div>

      <!-- Filters -->
      <form method="GET" action="/admin/homework" class="flex flex-wrap gap-3">
        <input type="text" name="search" value="<%= search %>" placeholder="Search homework..."
               class="flex-1 min-w-48 px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30 bg-white"/>
        <select name="course" class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
          <option value="">All Courses</option>
          <% courses.forEach(c => { %>
            <option value="<%= c._id %>" <%= courseFilter === c._id.toString() ? 'selected' : '' %>><%= c.title %></option>
          <% }) %>
        </select>
        <button type="submit" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-900 text-white text-sm font-semibold rounded-xl transition">Filter</button>
        <% if (search || courseFilter) { %>
          <a href="/admin/homework" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold rounded-xl transition">Clear</a>
        <% } %>
      </form>

      <!-- Homework Table -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <% if (homework && homework.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                  <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Homework</th>
                  <th class="px-4 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Lesson</th>
                  <th class="px-4 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Course / Batch</th>
                  <th class="px-4 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Due Date</th>
                  <th class="px-4 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Submissions</th>
                  <th class="px-4 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                  <th class="px-4 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% homework.forEach(hw => { %>
                  <tr class="hover:bg-slate-50 transition">
                    <td class="px-6 py-4">
                      <div class="font-semibold text-slate-900"><%= hw.title %></div>
                      <% if (hw.description) { %>
                        <div class="text-xs text-slate-400 mt-0.5 line-clamp-1"><%= hw.description %></div>
                      <% } %>
                    </td>
                    <td class="px-4 py-4 text-slate-600"><%= hw.lesson?.title || '—' %></td>
                    <td class="px-4 py-4">
                      <div class="text-slate-700 font-medium"><%= hw.course?.title || '—' %></div>
                      <% if (hw.batch) { %>
                        <div class="text-xs text-slate-400"><%= hw.batch.batchName %></div>
                      <% } %>
                    </td>
                    <td class="px-4 py-4 text-slate-600">
                      <% if (hw.dueDate) { %>
                        <%
                          const due = new Date(hw.dueDate);
                          const now = new Date();
                          const isOverdue = due < now && hw.status === 'active';
                        %>
                        <span class="<%= isOverdue ? 'text-red-600 font-semibold' : 'text-slate-600' %>">
                          <%= due.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </span>
                        <% if (isOverdue) { %><div class="text-xs text-red-500">Overdue</div><% } %>
                      <% } else { %>
                        <span class="text-slate-400">No due date</span>
                      <% } %>
                    </td>
                    <td class="px-4 py-4">
                      <a href="/admin/homework/<%= hw._id %>/review"
                         class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-brand-navy font-semibold text-xs rounded-lg transition">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        <%= hw.submissionCount %> submitted
                      </a>
                    </td>
                    <td class="px-4 py-4">
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold
                        <%= hw.status === 'active' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-500' %>">
                        <%= hw.status === 'active' ? 'Active' : 'Closed' %>
                      </span>
                    </td>
                    <td class="px-4 py-4">
                      <div class="flex items-center justify-end gap-2">
                        <a href="/admin/homework/<%= hw._id %>/review"
                           class="p-2 rounded-lg text-brand-navy hover:bg-indigo-50 transition" title="Review Submissions">
                          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
                        </a>
                        <a href="/admin/homework/<%= hw._id %>/edit"
                           class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 transition" title="Edit">
                          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </a>
                        <form method="POST" action="/admin/homework/<%= hw._id %>/delete"
                              onsubmit="return confirm('Delete this homework? All submissions will also be deleted.')">
                          <button type="submit" class="p-2 rounded-lg text-red-400 hover:bg-red-50 transition" title="Delete">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <% if (totalPages > 1) { %>
            <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between">
              <p class="text-sm text-slate-500">Page <%= currentPage %> of <%= totalPages %></p>
              <div class="flex gap-2">
                <% if (currentPage > 1) { %>
                  <a href="?page=<%= currentPage - 1 %>&search=<%= search %>&course=<%= courseFilter %>"
                     class="px-4 py-2 text-sm bg-slate-100 hover:bg-slate-200 rounded-xl transition">← Previous</a>
                <% } %>
                <% if (currentPage < totalPages) { %>
                  <a href="?page=<%= currentPage + 1 %>&search=<%= search %>&course=<%= courseFilter %>"
                     class="px-4 py-2 text-sm bg-brand-navy hover:bg-brand-navyDark text-white rounded-xl transition">Next →</a>
                <% } %>
              </div>
            </div>
          <% } %>

        <% } else { %>
          <div class="py-16 text-center">
            <svg class="w-12 h-12 mx-auto text-slate-300 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
            <p class="text-slate-500 font-medium">No homework assignments found.</p>
            <a href="/admin/homework/new" class="mt-3 inline-block text-brand-navy font-semibold text-sm hover:underline">+ Create your first homework</a>
          </div>
        <% } %>
      </div>

    </main>
  </div>
</div>

<%- include('../../layouts/footer') %>
</body>
</html>
