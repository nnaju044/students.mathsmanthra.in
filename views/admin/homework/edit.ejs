<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">

<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Homework' }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Edit Homework', pageSubtitle: 'Update homework assignment details.' }) %>

    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">
      <div class="max-w-2xl mx-auto">
        <div class="mb-6">
          <a href="/admin/homework" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-brand-navy transition font-medium">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Back to Homework
          </a>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
          <h1 class="text-2xl font-extrabold text-slate-900 mb-6">Edit Homework</h1>

          <% if (error) { %>
            <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"><%= error %></div>
          <% } %>

          <form method="POST" action="/admin/homework/<%= hw._id %>" enctype="multipart/form-data" class="space-y-5">

            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Homework Title <span class="text-red-500">*</span></label>
              <input type="text" name="title" value="<%= hw.title %>" required
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
            </div>

            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Lesson <span class="text-red-500">*</span></label>
              <select name="lesson" required class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                <option value="">— Select a lesson —</option>
                <% lessons.forEach(l => { %>
                  <option value="<%= l._id %>" <%= hw.lesson?.toString() === l._id.toString() ? 'selected' : '' %>>
                    <%= l.title %> <%= l.course ? `(${l.course.title})` : '' %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Course</label>
                <select name="course" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                  <option value="">— All courses —</option>
                  <% courses.forEach(c => { %>
                    <option value="<%= c._id %>" <%= hw.course?.toString() === c._id.toString() ? 'selected' : '' %>><%= c.title %></option>
                  <% }) %>
                </select>
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Batch</label>
                <select name="batch" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                  <option value="">— All batches —</option>
                  <% batches.forEach(b => { %>
                    <option value="<%= b._id %>" <%= hw.batch?.toString() === b._id.toString() ? 'selected' : '' %>><%= b.batchName %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Description</label>
              <textarea name="description" rows="4"
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30 resize-none"><%= hw.description %></textarea>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Due Date</label>
                <input type="date" name="dueDate"
                       value="<%= hw.dueDate ? new Date(hw.dueDate).toISOString().split('T')[0] : '' %>"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Status</label>
                <select name="status" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-navy/30">
                  <option value="active" <%= hw.status === 'active' ? 'selected' : '' %>>Active</option>
                  <option value="closed" <%= hw.status === 'closed' ? 'selected' : '' %>>Closed</option>
                </select>
              </div>
            </div>

            <!-- Existing Attachments -->
            <% if (hw.attachments && hw.attachments.length > 0) { %>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Existing Attachments</label>
                <div class="space-y-2">
                  <% hw.attachments.forEach(att => { %>
                    <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200">
                      <svg class="w-5 h-5 text-brand-navy shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
                      <a href="<%= att.url %>" target="_blank" class="text-sm text-brand-navy hover:underline flex-1"><%= att.name %></a>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <!-- Add More Attachments -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Add More Attachments</label>
              <input type="file" name="attachments" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx"
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy/30"/>
            </div>

            <div class="flex gap-3 pt-2">
              <button type="submit" class="flex-1 py-3 bg-brand-navy hover:bg-brand-navyDark text-white font-semibold text-sm rounded-xl transition">
                Update Homework
              </button>
              <a href="/admin/homework" class="flex-1 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm rounded-xl transition text-center">
                Cancel
              </a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../../layouts/footer') %>
</body>
</html>
