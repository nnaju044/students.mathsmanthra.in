<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">
<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Payments' }) %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Invoice', pageSubtitle: payment.invoiceNumber || 'Generating...' }) %>
    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">

      <!-- Action Bar -->
      <div class="flex items-center justify-between mb-8">
        <a href="/admin/payments" class="flex items-center gap-2 text-sm text-slate-500 hover:text-slate-800 transition">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Back to Payments
        </a>
        <a href="/admin/payments/<%= payment._id %>/download"
           class="flex items-center gap-2 px-5 py-2.5 bg-indigo-600 text-white text-sm font-semibold rounded-xl hover:bg-indigo-700 transition shadow-sm">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download PDF
        </a>
      </div>

      <!-- Invoice Card -->
      <div class="max-w-3xl mx-auto bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">

        <!-- Invoice Header -->
        <div class="bg-gradient-to-r from-indigo-600 to-purple-600 px-8 py-8 text-white">
          <div class="flex items-start justify-between">
            <div>
              <h1 class="text-2xl font-bold tracking-tight">Maths Manthra Academy</h1>
              <p class="text-indigo-200 text-sm mt-1">Premium Mathematics Education</p>
            </div>
            <div class="text-right">
              <div class="text-indigo-200 text-xs uppercase tracking-widest font-semibold">Invoice</div>
              <div class="text-white font-mono font-bold text-lg mt-1"><%= payment.invoiceNumber || 'Generating...' %></div>
            </div>
          </div>
        </div>

        <!-- Invoice Meta -->
        <div class="grid grid-cols-3 bg-slate-50 border-b border-slate-200 divide-x divide-slate-200">
          <div class="px-6 py-4">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Invoice Number</div>
            <div class="text-sm font-mono font-semibold text-indigo-700 mt-1"><%= payment.invoiceNumber || '—' %></div>
          </div>
          <div class="px-6 py-4">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Invoice Date</div>
            <div class="text-sm font-semibold text-slate-800 mt-1">
              <%= new Date(payment.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'long', year: 'numeric' }) %>
            </div>
          </div>
          <div class="px-6 py-4">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Status</div>
            <% const statusColors = { completed: 'text-emerald-700 bg-emerald-50 border-emerald-200', pending: 'text-amber-700 bg-amber-50 border-amber-200', failed: 'text-red-700 bg-red-50 border-red-200' }; %>
            <span class="inline-flex mt-1 px-2.5 py-0.5 rounded-full text-xs font-bold border capitalize <%= statusColors[payment.status] || statusColors.pending %>">
              <%= payment.status %>
            </span>
          </div>
        </div>

        <div class="px-8 py-6 space-y-6">
          <!-- Billed To -->
          <div>
            <h3 class="text-xs font-semibold text-indigo-600 uppercase tracking-widest mb-3">Billed To</h3>
            <div class="text-slate-800 font-bold text-lg"><%= payment.student?.name || '—' %></div>
            <% if (payment.student?.phone) { %><div class="text-sm text-slate-500 mt-1"> <%= payment.student.phone %></div><% } %>
            <% if (payment.student?.email) { %><div class="text-sm text-slate-500"> <%= payment.student.email %></div><% } %>
          </div>

          <div class="border-t border-slate-100"></div>

          <!-- Course Info -->
          <div>
            <h3 class="text-xs font-semibold text-indigo-600 uppercase tracking-widest mb-3">Course Details</h3>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <div class="text-xs text-slate-400 font-medium">Course</div>
                <div class="text-sm font-semibold text-slate-800 mt-1"><%= payment.course?.title || '—' %></div>
              </div>
              <div>
                <div class="text-xs text-slate-400 font-medium">Batch</div>
                <div class="text-sm font-semibold text-slate-800 mt-1"><%= payment.batch?.batchName || '—' %></div>
              </div>
            </div>
          </div>

          <div class="border-t border-slate-100"></div>

          <!-- Payment Details -->
          <div>
            <h3 class="text-xs font-semibold text-indigo-600 uppercase tracking-widest mb-3">Payment Details</h3>
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-sm text-slate-500">Amount Paid</span>
                <span class="text-sm font-bold text-slate-900">₹<%= (payment.amount || 0).toLocaleString('en-IN') %></span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm text-slate-500">Payment Method</span>
                <span class="text-sm font-semibold text-slate-700 capitalize"><%= (payment.paymentMethod || 'cash').replace('_', ' ') %></span>
              </div>
              <% if (payment.transactionId) { %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-slate-500">Transaction ID</span>
                <span class="text-sm font-mono text-slate-700"><%= payment.transactionId %></span>
              </div>
              <% } %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-slate-500">Payment Date</span>
                <span class="text-sm font-semibold text-slate-700">
                  <%= payment.paidDate ? new Date(payment.paidDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'long', year: 'numeric' }) : '—' %>
                </span>
              </div>
            </div>
          </div>

          <!-- Total Amount Box -->
          <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-xl px-6 py-4 flex items-center justify-between">
            <span class="text-white/80 text-sm font-medium">Total Amount Paid</span>
            <span class="text-white text-2xl font-bold">₹<%= (payment.amount || 0).toLocaleString('en-IN') %></span>
          </div>

          <% if (payment.notes) { %>
          <div class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3">
            <div class="text-xs font-semibold text-amber-700 uppercase tracking-wider mb-1">Notes</div>
            <div class="text-sm text-amber-800"><%= payment.notes %></div>
          </div>
          <% } %>
        </div>

        <!-- Footer -->
        <div class="px-8 py-5 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
          <div>
            <div class="text-xs font-semibold text-slate-700">Authorized Signatory</div>
            <div class="text-xs text-slate-400 mt-0.5">Maths Manthra Academy</div>
          </div>
          <div class="text-xs text-slate-400 text-right">
            Computer-generated invoice<br>No physical signature required.
          </div>
        </div>

      </div>
    </main>
    <%- include('../../layouts/footer') %>
  </div>
</div>
</body>
</html>
