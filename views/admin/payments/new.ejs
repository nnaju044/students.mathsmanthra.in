<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head><%- include('../../partials/head') %></head>
<body class="h-full bg-slate-50 text-slate-800">
<div class="flex h-full min-h-screen">
  <%- include('../../layouts/sidebar', { activePage: 'Payments' }) %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../../layouts/header', { pageTitle: 'Record Payment', pageSubtitle: 'Log a student fee payment.' }) %>
    <main class="flex-1 px-6 sm:px-8 py-8 overflow-y-auto">
      <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
          <% if (error) { %>
            <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"><%= error %></div>
          <% } %>
          <form method="POST" action="/admin/payments" class="space-y-5">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Student <span class="text-red-500">*</span></label>
              <select name="student" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition">
                <option value="">Select Student</option>
                <% students.forEach(s => { %>
                  <option value="<%= s._id %>"><%= s.name %> — <%= s.phone %></option>
                <% }) %>
              </select>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Course</label>
                <select name="course" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition">
                  <option value="">— Select course (optional) —</option>
                  <% (typeof courses !== 'undefined' ? courses : []).forEach(c => { %>
                    <option value="<%= c._id %>"><%= c.title %></option>
                  <% }) %>
                </select>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Batch</label>
                <select name="batch" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition">
                  <option value="">— Select batch (optional) —</option>
                  <% (typeof batches !== 'undefined' ? batches : []).forEach(b => { %>
                    <option value="<%= b._id %>"><%= b.batchName %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Amount (₹) <span class="text-red-500">*</span></label>
                <input type="number" name="amount" required min="0" step="1" placeholder="e.g. 15000"
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Payment Date</label>
                <input type="date" name="paidDate" value="<%= new Date().toISOString().split('T')[0] %>"
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Payment Method</label>
                <select name="paymentMethod" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition">
                  <option value="cash">Cash</option>
                  <option value="upi">UPI</option>
                  <option value="bank_transfer">Bank Transfer</option>
                  <option value="card">Card</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Status</label>
                <select name="status" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition">
                  <option value="completed">Completed</option>
                  <option value="pending">Pending</option>
                  <option value="failed">Failed</option>
                </select>
              </div>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Transaction ID / Reference</label>
              <input type="text" name="transactionId" placeholder="e.g. UPI-12345 or cheque number"
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Notes</label>
              <textarea name="notes" rows="2" placeholder="Any additional notes..."
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-navy focus:ring-1 focus:ring-brand-navy/30 text-sm transition resize-none"></textarea>
            </div>
            <div class="flex items-center justify-end gap-3 pt-2">
              <a href="/admin/payments" class="px-5 py-3 text-sm font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition">Cancel</a>
              <button type="submit" class="px-6 py-3 bg-brand-navy hover:bg-brand-navyDark text-white font-bold text-sm rounded-xl shadow-sm transition">Record Payment</button>
            </div>
          </form>
        </div>
      </div>
    </main>
    <%- include('../../layouts/footer') %>
  </div>
</div>
</body>
</html>
