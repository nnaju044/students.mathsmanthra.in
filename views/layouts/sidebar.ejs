<%
  const _activePage = typeof activePage !== 'undefined' ? activePage : '';
  const sidebarNavItems = [
    { label: 'Dashboard', href: '/admin/dashboard',
      icon: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>' },
    { label: 'Students', href: '/admin/students',
      icon: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16.5 8.5a3 3 0 1 1 0-6"/><path d="M15 14.5c2.7.3 4.8 1.8 5.5 4.5"/>' },
    { label: 'Courses', href: '/admin/courses',
      icon: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5v-15Z"/><path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20"/>' },
    { label: 'Batches', href: '/admin/batches',
      icon: '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/>' },
    { label: 'Lessons', href: '/admin/lessons',
      icon: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5v-15Z"/><path d="M8 8h8M8 12h5"/>' },
    { label: 'Homework', href: '/admin/homework',
      icon: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>' },
    { label: 'Attendance', href: '/admin/attendance',
      icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/>' },
    { label: 'Payments', href: '/admin/payments',
      icon: '<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 10h19"/><path d="M6 15h4"/>' },
    { label: 'Announcements', href: '/admin/announcements',
      icon: '<path d="M4 10v4a1 1 0 0 0 1 1h2l5 4V5L7 9H5a1 1 0 0 0-1 1Z"/><path d="M16 9a3 3 0 0 1 0 6"/>' },
  ];
%>

<!-- Mobile Sidebar Overlay -->
<div id="sidebarOverlay" class="sidebar-overlay fixed inset-0 bg-black/40 z-40 lg:hidden" onclick="closeMobileSidebar()"></div>

<!-- Mobile Sidebar Drawer -->
<aside id="mobileSidebar" class="sidebar-mobile fixed inset-y-0 left-0 w-64 z-50 flex flex-col bg-white border-r border-slate-200 lg:hidden">
  <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
    <div>
      <%- include('../partials/logo', { logoSize: 'md', logoHref: '/admin/dashboard' }) %>
      <p class="text-xs font-medium text-slate-400 mt-1">Admin Portal</p>
    </div>
    <button onclick="toggleMobileSidebar()" class="text-slate-400 hover:text-slate-600">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <nav class="flex-1 px-4 py-5 space-y-1 overflow-y-auto">
    <% sidebarNavItems.forEach(item => { %>
      <a href="<%= item.href %>"
         class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition
                <%= _activePage === item.label ? 'bg-brand-navy text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
        <svg class="shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- item.icon %></svg>
        <span><%= item.label %></span>
      </a>
    <% }) %>
  </nav>
  <div class="p-4 border-t border-slate-100">
    <a href="/admin/logout" class="w-full flex items-center justify-center gap-2 bg-red-50 hover:bg-red-100 text-red-600 font-semibold text-sm py-3 rounded-xl transition">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      Logout
    </a>
  </div>
</aside>

<!-- Desktop Sidebar -->
<aside class="hidden lg:flex lg:w-64 flex-col bg-white border-r border-slate-200 shrink-0">
  <div class="px-6 py-5 border-b border-slate-100">
    <%- include('../partials/logo', { logoSize: 'md', logoHref: '/admin/dashboard' }) %>
    <p class="text-xs font-medium text-slate-400 mt-1">Admin Portal</p>
  </div>
  <nav class="flex-1 px-4 py-5 space-y-1 overflow-y-auto">
    <% sidebarNavItems.forEach(item => { %>
      <a href="<%= item.href %>"
         class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition
                <%= _activePage === item.label ? 'bg-brand-navy text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
        <svg class="shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- item.icon %></svg>
        <span><%= item.label %></span>
      </a>
    <% }) %>
  </nav>
  <div class="p-4 border-t border-slate-100">
    <a href="/admin/announcements/new"
       class="w-full flex items-center justify-center gap-2 bg-brand-navy hover:bg-brand-navyDark text-white font-semibold text-sm py-3 rounded-xl transition">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      New Announcement
    </a>
  </div>
</aside>

<script>
function toggleMobileSidebar() {
  const sidebar = document.getElementById('mobileSidebar');
  const overlay = document.getElementById('sidebarOverlay');
  if (!sidebar || !overlay) return;
  const isOpen = sidebar.classList.toggle('active');
  overlay.classList.toggle('active', isOpen);
  document.body.style.overflow = isOpen ? 'hidden' : '';
}

function closeMobileSidebar() {
  const sidebar = document.getElementById('mobileSidebar');
  const overlay = document.getElementById('sidebarOverlay');
  if (!sidebar || !overlay) return;
  sidebar.classList.remove('active');
  overlay.classList.remove('active');
  document.body.style.overflow = '';
}

// Close on Escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeMobileSidebar();
});
</script>
