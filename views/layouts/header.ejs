<%
  const _admin = (typeof admin !== 'undefined' && admin) ? admin : { name: 'Admin', email: 'admin@mathsmanthra.com' };
  const _pageTitle = typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard';
  const _pageSubtitle = typeof pageSubtitle !== 'undefined' ? pageSubtitle : '';
%>
<header class="bg-white border-b border-slate-200 px-6 sm:px-8 py-5 flex items-center justify-between gap-4">
  <div class="flex items-center gap-4">
    <!-- Mobile hamburger -->
    <button onclick="toggleMobileSidebar()" class="lg:hidden w-10 h-10 rounded-xl border border-slate-200 flex items-center justify-center text-slate-500 hover:bg-slate-50 transition">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight"><%= _pageTitle %></h1>
      <% if (_pageSubtitle) { %>
        <p class="text-slate-500 text-sm mt-0.5"><%= _pageSubtitle %></p>
      <% } %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <div class="hidden sm:block text-right">
      <div class="text-sm font-semibold text-slate-800 leading-tight"><%= _admin.name %></div>
      <% if (_admin.email) { %>
        <div class="text-xs text-slate-400 leading-tight"><%= _admin.email %></div>
      <% } %>
    </div>
    <a href="/admin/logout" class="hidden sm:flex items-center gap-2 px-4 py-2 bg-red-50 hover:bg-red-100 border border-red-200 text-red-600 font-semibold text-xs rounded-xl transition">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      Logout
    </a>
    <div class="w-10 h-10 rounded-full bg-brand-navy text-white flex items-center justify-center font-bold text-sm">
      <%= ((_admin && _admin.name) ? _admin.name : 'A').charAt(0).toUpperCase() %>
    </div>
  </div>
</header>

<!-- Flash messages -->
<% if (typeof error !== 'undefined' && error) { %>
  <div class="mx-6 sm:mx-8 mt-5 p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-sm flex items-start gap-3">
    <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <span><%= error %></span>
  </div>
<% } %>
<% if (typeof success !== 'undefined' && success) { %>
  <div class="mx-6 sm:mx-8 mt-5 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm flex items-start gap-3">
    <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <span><%= success %></span>
  </div>
<% } %>
