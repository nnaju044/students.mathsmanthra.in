<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error — Maths Manthra</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 flex items-center justify-center p-6">
  <div class="max-w-md w-full text-center bg-slate-900 border border-slate-800 p-8 rounded-3xl shadow-2xl">
    <div class="text-6xl font-extrabold text-amber-500 mb-4"><%= (typeof error !== 'undefined' && error && error.status) ? error.status : 404 %></div>
    <h1 class="text-2xl font-bold mb-2"><%= (typeof message !== 'undefined' && message) ? message : 'Something went wrong' %></h1>
    <p class="text-slate-400 text-sm mb-6">The requested page could not be found or an error occurred.</p>
    <a href="/admin/login" class="inline-block px-6 py-3 bg-amber-500 text-slate-950 font-bold rounded-xl shadow-lg hover:bg-amber-400 transition text-sm">
      Return to Admin Login
    </a>
  </div>
</body>
</html>
